{
  "manifest_version": 3,
  "name": "Nexus Passwords",
  "version": "1.0.0",
  "description": "Local passwords from your Nexus desktop. No server, no account.",
  "key": "",
  "minimum_chrome_version": "130",
  "permissions": ["nativeMessaging", "alarms", "offscreen", "clipboardWrite", "webNavigation"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Nexus Passwords",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": { "open-menu": { "suggested_key": { "default": "Alt+Shift+K" }, "description": "Open the Nexus menu on the focused login field" } },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["menu.html"], "matches": ["http://*/*", "https://*/*"], "use_dynamic_url": true }],
  "content_security_policy": { "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; form-action 'none'; base-uri 'none'" }
}
