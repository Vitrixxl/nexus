[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse files and folders
Exec=nexus-files %U
Icon=system-file-manager
Terminal=false
StartupNotify=true
Categories=System;FileTools;FileManager;Utility;
MimeType=inode/directory;
StartupWMClass=io.github.vitrixxl.NexusFiles
Actions=Phone;

[Desktop Action Phone]
Name=Phone
Exec=nexus-files --phone
